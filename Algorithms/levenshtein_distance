    for j in range(1, n + 1):
        for i in range(1, m + 1):
            if t1[i - 1] == t2[j - 1]:   
                substitutionCost = 0
            else:
                substitutionCost = 1
            di[i].insert(j, min(di[i - 1][j] + 1,
                               di[i][j - 1] + 1,
                               di[i - 1][j - 1] + substitutionCost))
