class Interface():
    def __init__(self, root):
        self.root = root
        self.root.title = "Number Predictor"
        self.canvas = tk.Canvas(root, width=280, height=280, bg='black')
        self.canvas.pack()
        self.image = Image.new("L", (280, 280), "black")
        self.draw = ImageDraw.Draw(self.image)
        tk.Button(root, text="Predict", command=self.predict).pack(side='left')
        tk.Button(root, text="Clear", command=self.clear).pack(side='right')
        self.label = tk.Label(root, text="Draw a digit", font=("Arial", 20))
        self.label.pack()
        self.canvas.bind("<B1-Motion>", self.paint)
    def paint(self, event):
        x, y = event.x, event.y
        r = 15
        self.canvas.create_oval(x-r, y-r, x+r, y+r, fill='white', outline='white')
        self.draw.ellipse([x-r, y-r, x+r, y+r], fill='white')
    def predict(self):
        img = self.image.resize((28, 28)).convert('L')
        img = (np.array(img).astype('float32') / 255.0).reshape(1, -1)
        prediction = mlp.predict(img)
        print(prediction)
        self.label.config(text=f"Predicted: {prediction[0]}")
    def clear(self):
        self.canvas.delete("all")
        self.image = Image.new("L", (280, 280), "black")
        self.draw = ImageDraw.Draw(self.image)
        self.label.config(text="Draw a digit")
root = tk.Tk()
app = Interface(root)
root.mainloop()
