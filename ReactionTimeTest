def save_image(link, location, url=True):
    if url == True:
        response = requests.get(link)
        img = io.BytesIO(response.content)
        img.seek(0)
    else:
        img = link
    img = Image.open(img).convert('L')
    img.thumbnail((400, 400), Image.Resampling.LANCZOS) 
    img.save(location, quality=85)
