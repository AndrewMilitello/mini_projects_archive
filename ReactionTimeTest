def prepare_image(img_id, blur_id):
    img1 = Image.open(f"images/image-{img_id[0]}-{img_id[1]}.jpg").convert("RGBA")
    img2 = Image.open(f'blurs/blur{blur_id}.jpg').convert("RGBA").resize(img1.size)
    combined_image = ImageChops.blend(img1, img2, 0.68)
    imgw, imgh = combined_image.size
    horizborder = screen_width - imgw
    vertborder = screen_height-imgh
    if horizborder > vertborder:
        combined_image = combined_image.resize((screen_width, math.floor(imgh * (screen_width/imgw))), Image.Resampling.LANCZOS)
    else:
        combined_image = combined_image.resize((math.floor(imgw * (screen_height/imgh)), screen_height), Image.Resampling.LANCZOS)
    image_surface = pygame.image.frombuffer(combined_image.tobytes(), combined_image.size, combined_image.mode).convert_alpha()
    image_rect = image_surface.get_rect(center=(screen_width // 2, screen_height // 2))
    return image_surface, image_rect

