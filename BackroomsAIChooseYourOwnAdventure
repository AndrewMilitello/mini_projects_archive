def get_exit_info(level):
    curr_level = level
    info = requests.get(curr_level)
    html = BeautifulSoup(info.text, "html.parser")
    content = html.find("div", {"id": "page-content"})
    exits_headers = content.find_all(lambda tag: (tag.name in ["h2", "h3", "a"] and "exits" in tag.text.lower()) or 
                                (tag.name == "a" and "exits" in tag.text.lower()))
    
    exits_link = [] # links of found a tags for exits
    exits_html = [] # parent containers
    exits_text = []
    banned_classes = ["newpage", "footnote", "javascript"]
    scan_phrases = [
        "will lead to", "will lead you to", "can lead to", "can take", "leads to", "lead to",
        "will take you to", "will make you noclip into", "will eventually lead",
        "noclip into", "enter", "lead into", "leads into", "will open a threshold to",
        "will open a door to", "thresholds to", "will threshold to", "can be entered by", "can be accessed"
    ]
    for exits_header in exits_headers:
        if exits_header.name == "a" and "collapsible-block-link" in exits_header.get("class", []):
            parent = exits_header.find_parent("div", class_="collapsible-block")
            siblings = parent.find("div", class_="collapsible-block-content")
            siblings = siblings.find_all(["p", "ul", "ol", "div"])
        else: 
            siblings = exits_header.next_siblings
        for i in siblings:
            if i.name in ["h1", "h2", "h3", "h4"]:
                break
            if i.name in ["p", "ul", "ol", "div"]:
                for a in i.find_all("a"):
                    href = a.get("href", "").lower()
                    aclass = a.get("class", [])
                    is_exit = (not any(q in aclass for q in banned_classes) and 
                                    ("level" in href or "the" in href) and 
                                    "files" not in href and 
                                    href not in curr_level and
                                    href not in exits_link
                              )
                    if is_exit:
                        li_parent = a.find_parent("div", class_="styled-quote") or a.find_parent("li")
                        if li_parent:
                            outer_text = li_parent.get_text(strip=True)
                            exit_html = li_parent.decode_contents()
                        else:
                            outer_emt = a.find_parent(["li", "p"]) 
                            if outer_emt:
                                outer_text = outer_emt.get_text(strip=True)
                            else:
                                outer_emt = a.find_parent("div")
                            split_exits = outer_emt.decode_contents().split('<br/>')
                            
                            exit_html = next((s for s in split_exits if a.get('href') in s), "")
                            
                            outer_text = BeautifulSoup(exit_html, "html.parser").get_text(strip=True)
                        if '|' not in outer_text and '«' not in outer_text and ('Author' not in outer_text) and ('Source' not in outer_text):
                            exits_link.append(href)
                            exits_html.append(exit_html)
                            exits_text.append(outer_text)

    exits_list = [f"link: {l}, info: {t[:300]}" for l, t in zip(exits_link, exits_text)]
    return exits_list, exits_link, exits_html, exits_text
